{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StratForge",
  "version": "0.1.0",
  "identifier": "com.stratforge.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @stratforge/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @stratforge/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "StratForge",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "StratForge",
    "copyright": "© 2026 StratForge",
    "category": "Finance",
    "shortDescription": "AI-assisted trading-strategy terminal",
    "longDescription": "StratForge is a desktop terminal for designing, backtesting, and stress-testing trading strategies — with realistic execution costs, a full statistical robustness battery (Deflated Sharpe, Monte Carlo permutation, walk-forward), a cross-domain correlation engine, pairs/cointegration tools, and a bring-your-own-model AI quant analyst.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
