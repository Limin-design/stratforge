{
  "name": "@stratforge/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "smoke:csv": "node --experimental-strip-types scripts/csv-smoke.ts",
    "smoke:vault": "node --experimental-strip-types scripts/vault-smoke.ts",
    "smoke:chats": "node --experimental-strip-types scripts/chats-smoke.ts",
    "smoke:scrub": "tsx scripts/scrub-smoke.ts",
    "smoke:isolation": "tsx scripts/workspace-isolation-smoke.ts",
    "smoke:chart-drawings": "tsx scripts/chart-drawings-smoke.ts",
    "smoke:data-sources": "tsx scripts/data-sources-smoke.ts",
    "smoke:strategy-optimize": "tsx scripts/strategy-optimize-smoke.ts",
    "smoke:strategy-optimize-run": "tsx scripts/strategy-optimize-run-smoke.ts",
    "smoke:llm-endpoint": "tsx scripts/llm-endpoint-smoke.ts",
    "smoke": "pnpm smoke:csv && pnpm smoke:vault && pnpm smoke:chats && pnpm smoke:scrub && pnpm smoke:isolation && pnpm smoke:chart-drawings && pnpm smoke:data-sources && pnpm smoke:strategy-optimize && pnpm smoke:strategy-optimize-run && pnpm smoke:llm-endpoint"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@stratforge/data-import": "workspace:*",
    "@stratforge/dsl": "workspace:*",
    "@stratforge/engine": "workspace:*",
    "dockview": "^4.0.0",
    "lightweight-charts": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
